# ============================================================
# KnowBase 裸机部署环境变量
#
# 用法：cp deploy/baremetal/env.example /opt/knowbase/.env && vi /opt/knowbase/.env
# 该文件会被三个 systemd 服务通过 EnvironmentFile 共同读取。
#
# 注意：systemd 的 EnvironmentFile 不支持 shell 语法（不要写 export、不要用引号包裹、
#      不要写 $(...)），保持 KEY=value 一行一个即可。
# ============================================================

# ============ 应用主目录（数据库、上传、向量库、密钥、备份都在这）============
DATA_ROOT=/var/lib/knowbase

# ============ Redis（本机）============
# broker 用 db0，任务结果与机器人状态用 db1，与容器方案的取值保持一致
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/0

# ============ 向量库：留空/写 local 表示跑在应用进程内，不需要独立服务 ============
CHROMA_HOST=local

# ============ 模型缓存与下载源 ============
HF_HOME=/var/lib/knowbase/huggingface
HF_ENDPOINT=https://hf-mirror.com

# ============ 默认模型 ============
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_EMBEDDING_PROVIDER=local
DEFAULT_EMBEDDING=BAAI/bge-small-zh-v1.5
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============ 模型 API Key（留空可稍后在网页「设置」里填）============
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# ============ 飞书机器人 ============
# 留空也能跑：机器人会到网页「设置 → 飞书机器人」取配置，填完立即生效、不用重启
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============ RAG ============
# 2 GiB 内存下关掉索引期富化；机器升配后可改回 true 并重新索引资料
RAG_ENRICH_ENABLED=false
RAG_ENRICH_CONCURRENCY=1
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ============ 上传与日志 ============
UPLOAD_MAX_SIZE_MB=50
LOG_LEVEL=INFO

# ============ 账号与服务令牌：留空由程序自动生成并持久化 ============
JWT_SECRET=
SERVICE_TOKEN=

# ============ 浏览器来源（走 nginx 同源访问时影响不大，按实际地址填写更稳妥）============
CORS_ORIGINS=http://localhost

# ============ 机器人提醒 ============
REMINDERS_ENABLED=true
REMINDER_TIMEZONE=Asia/Shanghai
