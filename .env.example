# ============================================================
# KnowBase 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# ============ 飞书机器人配置 ============
# 飞书应用凭证（从飞书开放平台获取）
FEISHU_APP_ID=cli_aacd643aab615ce4
FEISHU_APP_SECRET=fJ4jNxOywLGiPOJUG22jvdT7OpzwapRs
# 飞书事件订阅验证 Token
FEISHU_VERIFICATION_TOKEN=your_verification_token
# 飞书 Encrypt Key（可选）
FEISHU_ENCRYPT_KEY=

# ============ LLM API Keys ============
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-1cd250a62d904e3185e5074cb54bff18
# 阿里通义千问 (DashScope) API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# 智谱 AI (GLM) API Key
ZHIPU_API_KEY=your-zhipu-api-key

# ============ 默认 LLM 配置 ============
# 默认 LLM 提供商: openai / deepseek / dashscope / zhipu / ollama
DEFAULT_LLM_PROVIDER=deepseek
# 默认 LLM 模型
DEFAULT_LLM_MODEL=deepseek-v4-flash
# 默认 Embedding 提供商: openai / dashscope / ollama
DEFAULT_EMBEDDING_PROVIDER=openai
# 默认 Embedding 模型
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ============ Ollama 本地模型配置 ============
# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ============ 文档处理配置 ============
# 文档分块大小（字符数）
CHUNK_SIZE=500
# 分块重叠大小（字符数）
CHUNK_OVERLAP=50
# RAG 检索返回的 Top-K 片段数
RAG_TOP_K=5

# ============ 系统配置 ============
# 后端服务端口
BACKEND_PORT=8000
# 前端服务端口
FRONTEND_PORT=3000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_SELECTED_TOP_K=8
RAG_SUPPORTED_THRESHOLD=0.58
RAG_SECOND_THRESHOLD=0.45
RAG_LIMITED_THRESHOLD=0.42
# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE=50
# 文件存储路径
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# ============ Redis 配置 ============
REDIS_URL=redis://redis:6379/0

# ============ ChromaDB 配置 ============
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 远程访问时建议开启，并设置随机密钥。飞书机器人使用同一个 SERVICE_TOKEN。
AUTH_ENABLED=false
JWT_SECRET=replace-with-a-long-random-secret
SERVICE_TOKEN=
BACKEND_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
