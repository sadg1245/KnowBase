# ============================================================
# KnowBase 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# ============ 飞书机器人配置 ============
# 飞书应用凭证（从飞书开放平台获取）。
# 推荐直接在网页「设置 → 飞书机器人」里填写：那里的值优先，且不需要重启机器人进程。
# 这两项留空不再是错误——机器人会停在“等待填写凭证”状态并定期重试。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
# 下面两项只有 webhook 回调模式才需要；本仓库的机器人走 WebSocket 长连接，不读取它们。
# 飞书事件订阅验证 Token
FEISHU_VERIFICATION_TOKEN=your_verification_token
# 飞书 Encrypt Key（可选）
FEISHU_ENCRYPT_KEY=

# ============ LLM API Keys ============
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 阿里通义千问 (DashScope) API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# 智谱 AI (GLM) API Key
ZHIPU_API_KEY=your-zhipu-api-key

# ============ 默认 LLM 配置 ============
# 默认 LLM 提供商: openai / deepseek / dashscope / zhipu / ollama
DEFAULT_LLM_PROVIDER=deepseek
# 默认 LLM 模型
DEFAULT_LLM_MODEL=deepseek-v4-flash
# 默认 Embedding 提供商: local（本地 sentence-transformers 模型）/ openai
# 注意：填 openai 必须同时配置 OPENAI_API_KEY，否则向量化会直接失败。
DEFAULT_EMBEDDING_PROVIDER=local
# 默认 Embedding 模型：provider=local 时是 sentence-transformers 的模型名
DEFAULT_EMBEDDING=BAAI/bge-small-zh-v1.5
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 下载地址：默认 embedding 走本地模型（BAAI/bge-small-zh-v1.5），
# 国内服务器必须改成镜像，否则模型拉不下来。国外机器可留空。
HF_ENDPOINT=https://hf-mirror.com

# ============ Ollama 本地模型配置 ============
# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ============ 文档处理配置 ============
# 文档分块大小（字符数）
CHUNK_SIZE=500
# 分块重叠大小（字符数）
CHUNK_OVERLAP=50
# RAG 检索返回的 Top-K 片段数
RAG_TOP_K=5

# ============ 系统配置 ============
# 后端服务端口
BACKEND_PORT=8000
# 前端服务端口
FRONTEND_PORT=3000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_SELECTED_TOP_K=8
RAG_SUPPORTED_THRESHOLD=0.58
RAG_SECOND_THRESHOLD=0.45
RAG_LIMITED_THRESHOLD=0.42
# 上传文件大小限制（MB）
UPLOAD_MAX_SIZE_MB=50
# 上传原文目录（容器内路径，需与 docker-compose 的卷挂载点一致）
UPLOAD_DIR=/app/uploads

# ============ Redis 配置 ============
REDIS_URL=redis://redis:6379/0

# ============ ChromaDB 配置 ============
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ============ 账号与服务身份（第一阶段）============
# 首次打开页面会创建一个账号；建号后设置入口关闭，只能登录与退出。
# 令牌密钥留空即可：首次启动自动生成并保存在应用主目录（<数据目录>/secrets），之后一直复用。
# 只有需要接管已有部署、或希望自己保管时才显式填写（≥32 位随机字符串）。
JWT_SECRET=
# 飞书机器人服务令牌：留空即可。后端首次启动会自动生成到 <数据目录>/secrets/service_token
# （权限 0600），飞书机器人读同一份文件，用户不需要填写任何令牌。
# 只有多机部署或想自己保管时才显式配置，此时两处填同一个值。
SERVICE_TOKEN=
BACKEND_ACCESS_TOKEN=

# ============ 头像与知识库封面 ============
# 受控媒体目录（与数据库同卷，便于整体备份）
MEDIA_DIR=/app/data/media
# 图片大小与像素上限
IMAGE_MAX_SIZE_MB=4
IMAGE_MAX_PIXELS=20000000
# 标签规范化边界（单个标签长度 / 标签总数）
TAG_MAX_LENGTH=32
TAG_MAX_COUNT=30
# 允许的前端来源，逗号分隔。
# 本地开发保持默认；部署到服务器时改成实际访问地址，例如：
#   CORS_ORIGINS=http://1.2.3.4:3000,https://你的域名
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
